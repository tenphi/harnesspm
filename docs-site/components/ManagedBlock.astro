---
/**
 * A managed block from AGENTS.md, as a file view: long lines wrap, headings
 * stand out and every unit ID, such as `(glaze:rules/colors)`, is highlighted.
 *
 *   <ManagedBlock marks={{ '#### Where colors come from': 'patched by uikit' }} />
 *
 * The text is a real excerpt in ../examples/uikit-app-agents.md. Edit it
 * there; a line that is only `…` marks a cut. `marks` puts a note after the
 * line with exactly that text. Styles are in ./file-view.ts.
 */
import excerpt from '../examples/uikit-app-agents.md?raw';
import { breakable } from './breakable.ts';
import { FileView } from './file-view.ts';

interface Props {
  /** The file name in the bar. */
  file?: string;
  /** The note beside it. */
  tag?: string;
  /** Line text → a note shown after that line. */
  marks?: Record<string, string>;
}

const { file = 'AGENTS.md', tag = 'managed block · written by harnesspm sync', marks = {} } = Astro.props;

const ID = /\(([a-z0-9.-]+:[a-z]+(?:\/[^\s)]+)?)\)/g;

type Part = { id: boolean; text: string };
type Line = { kind: 'Comment' | 'Heading' | 'Bullet' | 'Text' | 'Cut'; parts: Part[]; mark?: string };

function split(text: string): Part[] {
  const parts: Part[] = [];
  let last = 0;
  for (const match of text.matchAll(ID)) {
    const start = match.index ?? 0;
    if (start > last) parts.push({ id: false, text: text.slice(last, start) });
    parts.push({ id: true, text: match[0] });
    last = start + match[0].length;
  }
  if (last < text.length) parts.push({ id: false, text: text.slice(last) });
  return parts;
}

const lines: Line[] = excerpt
  .replace(/\n+$/, '')
  .split('\n')
  .map((text: string) => {
    const kind: Line['kind'] = text.startsWith('<!--')
      ? 'Comment'
      : text.startsWith('#')
        ? 'Heading'
        : text.startsWith('- ')
          ? 'Bullet'
          : text.trim() === '…'
            ? 'Cut'
            : 'Text';
    return { kind, parts: split(text), mark: marks[text] };
  });
---

<FileView data-not-content="">
  <figcaption data-element="Bar">
    <span data-element="Title">{file}</span>
    <span data-element="Tag">{tag}</span>
  </figcaption>
  <pre data-element="Body"><code>{lines.map((line) => (
    <span data-element={line.kind}>{line.parts.map((part) => (part.id ? <span data-element="Id">{part.text}</span> : <Fragment set:html={breakable(part.text)} />))}{line.mark ? <span data-element="Mark">{line.mark}</span> : null}</span>
  ))}</code></pre>
</FileView>
